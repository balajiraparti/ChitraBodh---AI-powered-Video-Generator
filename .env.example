# Copy to .env locally. Never commit real keys or paste them into chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
# Audition an Indian-accented voice in your own ElevenLabs account.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Adam — male narrator for testing
ELEVENLABS_MALE_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Monika Sogam — deep and natural
ELEVENLABS_FEMALE_VOICE_ID=C3aqZfd4M0h7Ys5tWGIS
# Choose a model supported by your voice and the with-timestamps endpoint.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional absolute path to an installed Chrome/Edge executable.
BROWSER_EXECUTABLE=
# ffmpeg/ffprobe must be installed and on PATH, or set executable paths here.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
