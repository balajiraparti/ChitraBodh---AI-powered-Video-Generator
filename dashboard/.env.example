# Copy to dashboard/.env.local for the Next.js app.
# Use a MongoDB replica set and include the database name in the URI.
MONGODB_URI=
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
# Enable only after confirming Monika Sogam is accessible on your ElevenLabs account.
MONIKA_VOICE_ENABLED=false

# Legacy adapter only. Planned Filebase storage settings are in the root .env.example.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
