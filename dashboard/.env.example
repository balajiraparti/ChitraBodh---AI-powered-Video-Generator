# Copy to dashboard/.env.local for the Next.js app.
# Use a MongoDB replica set and include the database name in the URI.
MONGODB_URI=
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
# Enable only after confirming Monika Sogam is accessible on your ElevenLabs account.
MONIKA_VOICE_ENABLED=false

# F15: Instagram API with Unified Login (server-only).
# Callback must be on the same HTTPS origin as BETTER_AUTH_URL.

# Meta app credentials (not legacy Instagram app credentials).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Instagram Login Compatible configuration; use 60-day system-user tokens.
INSTAGRAM_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=
# 32 random bytes encoded as 64 hex characters; keep stable and backed up privately.
INSTAGRAM_TOKEN_KEY=
# Select the supported Graph version configured in your Meta app, e.g. v27.0.
INSTAGRAM_API_VERSION=

# Optional for pre-migration R2 artifacts only. Filebase storage settings are in the root .env.example.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
